rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // دالة أمان مركزية: تضمن أن المستخدم يملك حساباً مفعلاً (is_verified == true) أو زائر رسمي (anonymous)
    function isVerifiedUser() {
      return request.auth != null && (
        request.auth.token.firebase.sign_in_provider == 'anonymous' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_verified == true
      );
    }

    // 👤 مجموعة المستخدمين ومعلومات الحساب
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /security/email_otp {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /diagnostic_history/{docId} {
        allow read, write: if isVerifiedUser() && request.auth.uid == userId;
      }
      
      match /history/{docId} {
        allow read, write: if isVerifiedUser() && request.auth.uid == userId;
      }
    }

    // 💬 منتدى ومجتمع الفنيين: القراءة عامة، لكن النشر والتفاعل محظور للحسابات غير المفعلة
    match /community_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isVerifiedUser();
    }
    
    match /forum_topics/{topicId} {
      allow read: if true;
      allow create, update, delete: if isVerifiedUser();
      
      match /replies/{replyId} {
        allow read: if true;
        allow create, update, delete: if isVerifiedUser();
      }
    }

    // 📋 منشورات مجتمع تبادل الخبرات المعتمدة (forum_posts) والردود المعتمدة
    match /forum_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isVerifiedUser();

      match /replies/{replyId} {
        allow read: if true;
        allow create: if isVerifiedUser();
        allow update, delete: if isVerifiedUser();
      }
    }

    // ⏳ طابور الأعطال والمنشورات المعلقة للمراجعة والاعتماد (pending_faults)
    match /pending_faults/{postId} {
      allow read, write: if isVerifiedUser();

      match /replies/{replyId} {
        allow read, write: if isVerifiedUser();
      }
    }

    // 🛠️ طلبات الفحص والمراجعة الإدارية
    match /admin_reviews/{reviewId} {
      allow read, write: if isVerifiedUser();
    }

    // 📚 الموسوعة الموثقة للأعطال (verified_faults): القراءة لجميع المستخدمين والضيوف، والكتابة محصورة للـ Super Admin
    match /verified_faults/{faultId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'drfixapp@gmail.com';
    }

    // 📨 طابور إرسال البريد السحابي (Trigger Email Extension / Cloud Mailer)
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
