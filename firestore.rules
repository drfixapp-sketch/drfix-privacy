rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 🛡️ القواعد الحية المفعّلة سحابياً على لوحة تحكم Firebase Console
    // 📖 القراءة متاحة للجميع (الزوار والمستخدمين) لتشغيل الخريطة والموسوعة والمنتدى
    // ✍️ الكتابة محصورة للمستخدمين المسجلين رسمياً عبر Firebase Auth (request.auth != null)
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
