// ═══════════════════════════════════════════
// UI STRINGS
// ═══════════════════════════════════════════
const UI = {
  ar: {
    appName: 'سياسة الخصوصية', appSub: 'تطبيق Dr. Fix',
    updated: 'آخر تحديث: أغسطس 2026',
    toc: 'جدول المحتويات',
    print: 'طباعة', copy: 'نسخ الرابط', copied: 'تم النسخ!',
    expand: 'توسيع الكل', collapse: 'طي الكل',
    backTop: 'العودة للأعلى'
  },
  en: {
    appName: 'Privacy Policy', appSub: 'Dr. Fix App',
    updated: 'Last Updated: August 2026',
    toc: 'Table of Contents',
    print: 'Print', copy: 'Copy Link', copied: 'Copied!',
    expand: 'Expand All', collapse: 'Collapse All',
    backTop: 'Back to Top'
  }
};

// ═══════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════
let currentLang = 'ar';

// ═══════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════
function render(lang) {
  const d = DATA[lang];
  const u = UI[lang];
  const isRtl = lang === 'ar';

  // Body dir
  document.documentElement.lang = lang;
  document.body.className = isRtl ? 'rtl' : 'ltr';
  document.body.dir = isRtl ? 'rtl' : 'ltr';

  // Header
  document.getElementById('h-app-name').textContent = u.appName;
  document.getElementById('h-app-sub').textContent = u.appSub;
  document.getElementById('h-updated').textContent = u.updated;

  // Lang buttons
  document.getElementById('btn-ar').className = 'btn btn-lang' + (lang === 'ar' ? ' active' : '');
  document.getElementById('btn-en').className = 'btn btn-lang' + (lang === 'en' ? ' active' : '');

  // Toolbar
  document.getElementById('t-print').textContent = u.print;
  document.getElementById('t-copy').textContent = u.copy;
  document.getElementById('t-expand').textContent = u.expand;
  document.getElementById('t-collapse').textContent = u.collapse;
  document.getElementById('back-to-top').setAttribute('aria-label', u.backTop);

  // TOC label
  document.getElementById('toc-label').textContent = u.toc;

  // TOC grid
  const tocGrid = document.getElementById('toc-grid');
  tocGrid.innerHTML = d.sections.map((sec, i) => `
    <div class="toc-item">
      <a href="#${sec.id}" onclick="openSection('${sec.id}')" aria-label="${sec.title}">
        <span class="toc-num">${i+1}</span> ${sec.title}
      </a>
    </div>
  `).join('');

  // Sections
  const container = document.getElementById('sections-container');
  container.innerHTML = d.sections.map((sec, i) => `
    <div class="section-card" id="${sec.id}" role="region" aria-labelledby="h-${sec.id}">
      <button class="accordion-header" onclick="toggleSection('${sec.id}')"
        aria-expanded="false" aria-controls="body-${sec.id}" id="h-${sec.id}">
        <div class="acc-left">
          <div class="section-num" aria-hidden="true">${i+1}</div>
          <div class="section-title">${sec.title}</div>
        </div>
        <svg class="acc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
      <div class="accordion-body" id="body-${sec.id}" role="region">
        <div class="acc-content">${sec.content}</div>
      </div>
    </div>
  `).join('');
}

// ═══════════════════════════════════════════
// ACCORDION
// ═══════════════════════════════════════════
function toggleSection(id) {
  const card = document.getElementById(id);
  const body = document.getElementById('body-' + id);
  const btn  = card.querySelector('.accordion-header');
  const isOpen = card.classList.contains('open');
  card.classList.toggle('open', !isOpen);
  body.classList.toggle('open', !isOpen);
  btn.setAttribute('aria-expanded', String(!isOpen));
}

function openSection(id) {
  const card = document.getElementById(id);
  const body = document.getElementById('body-' + id);
  const btn  = card.querySelector('.accordion-header');
  card.classList.add('open');
  body.classList.add('open');
  btn.setAttribute('aria-expanded', 'true');
}

function expandAll() {
  document.querySelectorAll('.section-card').forEach(card => {
    const id = card.id;
    const body = document.getElementById('body-' + id);
    const btn  = card.querySelector('.accordion-header');
    card.classList.add('open');
    body.classList.add('open');
    btn.setAttribute('aria-expanded', 'true');
  });
}

function collapseAll() {
  document.querySelectorAll('.section-card').forEach(card => {
    const id = card.id;
    const body = document.getElementById('body-' + id);
    const btn  = card.querySelector('.accordion-header');
    card.classList.remove('open');
    body.classList.remove('open');
    btn.setAttribute('aria-expanded', 'false');
  });
}

// ═══════════════════════════════════════════
// LANG SWITCH
// ═══════════════════════════════════════════
function setLang(lang) {
  currentLang = lang;
  render(lang);
}

// ═══════════════════════════════════════════
// COPY LINK
// ═══════════════════════════════════════════
function copyLink(btn) {
  const url = window.location.href;
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(url).then(() => showCopied(btn));
  } else {
    const ta = document.createElement('textarea');
    ta.value = url; ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); showCopied(btn); } catch(e) {}
    document.body.removeChild(ta);
  }
}
function showCopied(btn) {
  const span = btn.querySelector('span');
  const u = UI[currentLang];
  const orig = span.textContent;
  btn.classList.add('copied');
  span.textContent = u.copied;
  setTimeout(() => { btn.classList.remove('copied'); span.textContent = u.copy; }, 2000);
}

// ═══════════════════════════════════════════
// BACK TO TOP
// ═══════════════════════════════════════════
window.addEventListener('scroll', () => {
  const btn = document.getElementById('back-to-top');
  btn.classList.toggle('visible', window.scrollY > 300);
}, { passive: true });

// ═══════════════════════════════════════════
// HASH NAVIGATION
// ═══════════════════════════════════════════
function handleHash() {
  const hash = window.location.hash.replace('#', '');
  if (hash && document.getElementById(hash)) {
    setTimeout(() => {
      openSection(hash);
      document.getElementById(hash).scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 100);
  }
}

// ═══════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════
render('ar');
window.addEventListener('hashchange', handleHash);
window.addEventListener('load', handleHash);
</script>
</body>
</html>
